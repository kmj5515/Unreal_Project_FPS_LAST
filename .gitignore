# Visual Studio user specific files
**/.vs/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
.vsconfig

# Precompiled Assets
**/SourceArt/**/*.png
**/SourceArt/**/*.tga

# Binary Files
**/Binaries/*
**/Plugins/**/Binaries/*

# Builds
**/Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!**/Build/*/
**/Build/*/**
!**/Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!**/Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
**/Saved/*

# Compiled source files for the engine to use
**/Intermediate/*
**/Plugins/**/Intermediate/*

# Cache files for the editor to use
**/DerivedDataCache/*

*Blaster
*RootShooter
*LyraStarterGame

.bkit/
.gemini/
.idea/
.agents/
.claude/

# 패키징 산출물. 각각 2.9GB 규모이고 빌드로 언제든 다시 만들 수 있다.
# Deploy_Server 아래 Server-PC-Package/Server.config.psd1은 그 PC 전용 설정이라
# 산출물과 함께 무시된다. 설정 원본은 Tools/ServerAutomation/Server-PC-Package에 있다.
/PackagedClient/
/Deploy_Server/
/ServerBuilds/

# Local Unreal SOLID harness notes
Docs/UnrealSOLIDHarness/

# 로컬 에디터 전용 배틀 시나리오 에셋
LastFPS/Content/Editor/BattleScenarios/**
LastFPS/Plugins/UnrealMCP/
LastFPS/.mcp.json
.claude/settings.local.json

# graphify 지식 그래프 산출물 및 AST 캐시 (재생성 가능)
graphify-out/
